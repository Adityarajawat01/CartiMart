MONGO_URI=mongodb://127.0.0.1:27017/cartimart
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=8000
CORS_ORIGINS=http://localhost:5173

# The only administrator is created or refreshed from these server-only settings.
# Never expose these values through the frontend or commit a real .env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_NAME=CartiMart Admin
ADMIN_MOBILE=9876543210

# Optional integrations; set them only when those features are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
